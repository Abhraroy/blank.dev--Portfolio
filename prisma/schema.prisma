// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
  SELF_EMPLOYED
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProjectType {
  PERSONAL
  PROFESSIONAL
  OPEN_SOURCE
  CLIENT_WORK
  SIDE_PROJECT
}

enum ProjectVisibilityStatus {
  PUBLIC
  PRIVATE
  UNLISTED
  DRAFT
}

enum PortfolioBlockType {
  HERO
  CARD
  PROFILE
  TEXT
  LIST
  MEDIA
  CTA
}

enum PortfolioBlockItemType {
  TEXT
  BULLET
  LINK
}

// ---------------------------------------------------------------------------
// Portfolio Mode (master persona controller)
// ---------------------------------------------------------------------------

model PortfolioMode {
  id               String   @id @default(uuid())
  mode_name        String   @unique
  mode_description String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  projectModeContents    ProjectModeContent[]
  experienceModeContents ExperienceModeContent[]
  myDetailsModeContents  MyDetailsModeContent[]
  portfolioBlocks        PortfolioBlock[]

  @@index([mode_name])
}

// ---------------------------------------------------------------------------
// Project (facts only)
// ---------------------------------------------------------------------------

model Project {
  id                        String                  @id @default(uuid())
  project_name              String
  slug                      String                  @unique
  project_image             String?
  project_images            String[]                @default([])
  project_videos            String[]                @default([])
  project_url               String?
  project_github            String?
  project_md_url            String?
  project_tags              String[]
  project_tech              String[]
  project_status            ProjectStatus
  project_type              ProjectType
  project_visibility_status ProjectVisibilityStatus @default(PUBLIC)
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  modeContents ProjectModeContent[]
  highlights   ProjectHighlight[]
  selectedWorkCMSItems SelectedWorkSectionCMSItem[]
  projectShowcaseCMSItems ProjectShowcaseSectionCMSItem[]

  interaction               ProjectInteraction?


  @@index([project_status])
  @@index([project_type])
  @@index([project_visibility_status])
  @@index([slug])
}

// ---------------------------------------------------------------------------
// Project Mode Content (storytelling per persona)
// ---------------------------------------------------------------------------

model ProjectModeContent {
  id                   String   @id @default(uuid())
  projectId            String
  portfolioModeId      String
  project_description  String?
  project_highlights   String[]
  project_user_count   Int?
  project_revenue      Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  portfolioMode PortfolioMode @relation(fields: [portfolioModeId], references: [id], onDelete: Cascade)

  @@unique([projectId, portfolioModeId])
  @@index([projectId])
  @@index([portfolioModeId])
}

// ---------------------------------------------------------------------------
// Experience (facts only)
// ---------------------------------------------------------------------------

model Experience {
  id                String         @id @default(uuid())
  company_name      String
  role_title        String
  employment_type   EmploymentType
  location          String?
  start_date        DateTime
  end_date          DateTime?
  currently_working Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  modeContents ExperienceModeContent[]
  metrics      ExperienceMetric[]
  achievements ExperienceAchievement[]
  cmsItems     ExperienceSectionCMSItem[]

  @@index([company_name])
  @@index([start_date])
  @@index([currently_working])
}

// ---------------------------------------------------------------------------
// Experience Mode Content (storytelling per persona)
// ---------------------------------------------------------------------------

model ExperienceModeContent {
  id                     String   @id @default(uuid())
  experienceId           String
  portfolioModeId        String
  experience_description String?
  experience_highlights  String[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  experience    Experience    @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  portfolioMode PortfolioMode @relation(fields: [portfolioModeId], references: [id], onDelete: Cascade)

  @@unique([experienceId, portfolioModeId])
  @@index([experienceId])
  @@index([portfolioModeId])
}

// ---------------------------------------------------------------------------
// My Details (facts only)
// ---------------------------------------------------------------------------

model MyDetails {
  id                  String   @id @default(uuid())
  full_name           String
  profile_image       String?
  resume_url          String?
  email               String   @unique
  github_url          String?
  linkedin_url        String?
  x_url               String?
  instagram_url       String?
  discord_url         String?
  website_url         String?
  location            String?
  years_of_experience Int?     @default(4)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  modeContents MyDetailsModeContent[]
}

// ---------------------------------------------------------------------------
// My Details Mode Content (storytelling per persona)
// ---------------------------------------------------------------------------

model MyDetailsModeContent {
  id              String   @id @default(uuid())
  myDetailsId     String
  portfolioModeId String
  headline        String?
  short_bio       String?
  detailed_bio    String?
  highlights      String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  myDetails     MyDetails     @relation(fields: [myDetailsId], references: [id], onDelete: Cascade)
  portfolioMode PortfolioMode @relation(fields: [portfolioModeId], references: [id], onDelete: Cascade)

  @@unique([myDetailsId, portfolioModeId])
  @@index([myDetailsId])
  @@index([portfolioModeId])
}

// ---------------------------------------------------------------------------
// Portfolio Section (Generic container e.g. ABOUT, SKILLS, WORK)
// ---------------------------------------------------------------------------

model PortfolioSection {
  id        String           @id @default(uuid())
  key       String           @unique
  title     String
  visible   Boolean          @default(true)
  order     Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  blocks    PortfolioBlock[]

  @@index([key])
}

// ---------------------------------------------------------------------------
// Portfolio Block (Generic visual content area within a section)
// ---------------------------------------------------------------------------

model PortfolioBlock {
  id              String             @id @default(uuid())
  sectionId       String
  portfolioModeId String?
  blockNumber     Int
  type            PortfolioBlockType @default(CARD)
  visible         Boolean            @default(true)

  label       String?
  heading     String?
  subheading  String?
  description String?

  imageUrl    String?
  imageAlt    String?

  ctaText     String?
  ctaUrl      String?
  ctaType     String?
  ctaVisible  Boolean            @default(true)

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  section       PortfolioSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  portfolioMode PortfolioMode?       @relation(fields: [portfolioModeId], references: [id], onDelete: SetNull)
  items         PortfolioBlockItem[]

  @@index([sectionId])
  @@index([portfolioModeId])
  @@index([blockNumber])
}

// ---------------------------------------------------------------------------
// Portfolio Block Item (Child items: multi-paragraph text, bullets, links)
// ---------------------------------------------------------------------------

model PortfolioBlockItem {
  id        String                 @id @default(uuid())
  blockId   String
  type      PortfolioBlockItemType @default(TEXT)
  content   String
  url       String?
  order     Int                    @default(0)
  visible   Boolean                @default(true)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  block     PortfolioBlock         @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId])
  @@index([order])
}

// ---------------------------------------------------------------------------
// Factual Domain Extensions: Metrics, Achievements, Highlights
// ---------------------------------------------------------------------------

model ExperienceMetric {
  id           String     @id @default(uuid())
  experienceId String
  label        String     // e.g. "PIPELINES", "LATENCY CUT"
  value        String     // e.g. "8+", "40%"
  order        Int        @default(0)
  visible      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
  @@index([order])
}

model ExperienceAchievement {
  id           String     @id @default(uuid())
  experienceId String
  content      String     // Bullet point text
  order        Int        @default(0)
  visible      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
  @@index([order])
}

model ProjectHighlight {
  id        String   @id @default(uuid())
  projectId String
  content   String   // e.g. "REVENUE PLATFORM", "ADVANCED SEARCH"
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([order])
}

// ---------------------------------------------------------------------------
// Section CMS Composition Models (Selected Work, Experience, Showcase)
// ---------------------------------------------------------------------------

model ExperienceSectionCMS {
  id              String                    @id @default(uuid())
  key             String                    @unique @default("EXPERIENCE_MAIN")
  defaultActiveId String?                   // ID of experience entry to highlight initially on page load
  visible         Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  items           ExperienceSectionCMSItem[]
}

model ExperienceSectionCMSItem {
  id               String               @id @default(uuid())
  sectionId        String
  experienceId     String
  displayOrder     Int                  @default(0)
  visible          Boolean              @default(true)
  isFeatured       Boolean              @default(false)

  // Field-level visibility toggles
  showYear         Boolean              @default(true)
  showRole         Boolean              @default(true)
  showCompany      Boolean              @default(true)
  showDescription  Boolean              @default(true)
  showTechnologies Boolean              @default(true)
  showAchievements Boolean              @default(true)
  showMetrics      Boolean              @default(true)

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  section          ExperienceSectionCMS @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  experience       Experience           @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([sectionId, experienceId])
  @@index([sectionId])
  @@index([experienceId])
  @@index([displayOrder])
}

model SelectedWorkSectionCMS {
  id        String                     @id @default(uuid())
  key       String                     @unique @default("SELECTED_WORK_MAIN")
  visible   Boolean                    @default(true)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  items     SelectedWorkSectionCMSItem[]
}

model SelectedWorkSectionCMSItem {
  id               String                 @id @default(uuid())
  sectionId        String
  projectId        String
  displayOrder     Int                    @default(0)
  visible          Boolean                @default(true)
  offset           String?                // "up" | "down"
  customNumber     String?                // e.g. "01" (defaults to formatted displayOrder if null)

  // Field-level visibility toggles
  showOneLiner     Boolean                @default(true)
  showDescription  Boolean                @default(true)
  showTechnologies Boolean                @default(true)
  showHighlights   Boolean                @default(true)

  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  section          SelectedWorkSectionCMS @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([sectionId, projectId])
  @@index([sectionId])
  @@index([projectId])
  @@index([displayOrder])
}

model ProjectShowcaseSectionCMS {
  id        String                        @id @default(uuid())
  key       String                        @unique @default("PROJECT_SHOWCASE_MAIN")
  visible   Boolean                       @default(true)
  createdAt DateTime                      @default(now())
  updatedAt DateTime                      @updatedAt

  items     ProjectShowcaseSectionCMSItem[]
}

model ProjectShowcaseSectionCMSItem {
  id               String                    @id @default(uuid())
  sectionId        String
  projectId        String
  displayOrder     Int                       @default(0)
  visible          Boolean                   @default(true)

  // Field-level visibility toggles
  showDescription  Boolean                   @default(true)
  showTechnologies Boolean                   @default(true)
  showViewAction   Boolean                   @default(true)

  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  section          ProjectShowcaseSectionCMS @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  project          Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([sectionId, projectId])
  @@index([sectionId])
  @@index([projectId])
  @@index([displayOrder])
}

// ---------------------------------------------------------------------------
// Hero Nodes CMS Composition Models
// ---------------------------------------------------------------------------

model HeroSectionCMS {
  id               String            @id @default(uuid())
  key              String            @unique @default("HERO_NODES_MAIN")
  centerNodeLabel  String            @default("blankdev")
  centerLogoUrl    String?
  visible          Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  items            HeroNodeCMSItem[]
}

model HeroNodeCMSItem {
  id                   String         @id @default(uuid())
  sectionId            String
  nodeId               String         // Skill key e.g. "nextjs", "react", "typescript"
  label                String         // Display label on the 3D sphere node
  title                String         // Title on the InfoCard popup
  description          String         // Description body on the InfoCard
  techStack            String[]       @default([]) // Badges list on the InfoCard
  ctaLabel             String?        @default("View projects")
  ctaHref              String?        @default("/#work")
  image                String?        // Header image/banner URL for InfoCard
  displayOrder         Int            @default(0)
  visible              Boolean        @default(true)

  // Sizing & styling overrides for InfoCard
  cardWidth            String?
  cardHeight           String?
  cardMinHeight        String?
  cardImageHeight      String?
  titleFontSize        String?
  descriptionFontSize  String?
  techBadgeFontSize    String?
  ctaFontSize          String?

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  section              HeroSectionCMS @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([nodeId])
  @@index([displayOrder])
}



model WebsiteInteraction{
  id Int @id @default(1)
  resume_downloaded Int @default(0)
  contact_form_submit Int @default(0)
  contact_interested Int @default(0)
  scrolled_past_hero Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model ProjectInteraction {
  id              String   @id @default(uuid())
  projectId       String   @unique
  project_clicked Int      @default(0)
  project_viewed  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Mobile View Hero Section CMS Model (String records)
// ---------------------------------------------------------------------------

model MobileHeroSkill {
  id           String   @id @default(uuid())
  text         String
  displayOrder Int      @default(0)
  visible      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
}



